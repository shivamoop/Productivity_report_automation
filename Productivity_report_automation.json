    {
      "parameters": {
        "jsCode": "\n\n// Get all CSV rows\nconst rows = items.map(item => item.json);\n\n// Helper to safely parse numbers\nfunction num(v) {\n  const n = parseFloat(v);\n  return isNaN(n) ? 0 : n;\n}\n\n// Create pivot summary\nconst pivot = {}; // { WorkLocation: { Status: totalLength, ... } }\n\nfor (const r of rows) {\n  const location = (r[\"Recorder\"] || \"Unknown\").trim();  // You can switch to \"Work Location\"\n  const status = (r[\"Status\"] || \"Unknown\").trim();\n  const length = num(r[\"Length (Min)\"]);\n\n  if (!pivot[location]) pivot[location] = {};\n  pivot[location][status] = (pivot[location][status] || 0) + length;\n}\n\n// Prepare data for Google Sheet\nconst sheetRows = [];\n\nfor (const [location, statuses] of Object.entries(pivot)) {\n  const accepted = statuses[\"Accepted\"] || 0;\n  const pending = statuses[\"Pending\"] || 0;\n  const rejected = statuses[\"Rejected\"] || 0;\n  const total = accepted + pending + rejected;\n\n  sheetRows.push({\n    \"Recorder\": location,\n    \"Accepted\": parseFloat(accepted.toFixed(2)),\n    \"Pending\": parseFloat(pending.toFixed(2)),\n    \"Rejected\": parseFloat(rejected.toFixed(2)),\n    \"Grand Total\": parseFloat(total.toFixed(2))\n  });\n}\n\n// Add a header row if needed\nreturn sheetRows.map(r => ({ json: r }));\n"
      },
